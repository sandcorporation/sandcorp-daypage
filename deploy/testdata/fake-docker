#!/usr/bin/env bash
# deploy/deploy_test.sh 용 가짜 docker. 부른 명령을 $FAKE_LOG 에, 서비스 상태를 $FAKE_STATE 디렉터리에 남긴다.
#   서비스마다 <서비스>.image(떠 있는 이미지)·<서비스>.status(healthy | starting | unhealthy).
#   compose up 은 이미지가 바뀐 서비스만 다시 만든다(진짜 compose 처럼) → status=starting.
#   inspect 가 health 를 물으면 starting 을 healthy/unhealthy 로 정한다(그때까지 그 서비스는 요청을 못 받는다).
#   backend 를 다시 만드는 순간 다른 backend 가 healthy 가 아니면 「OUTAGE」를 로그에 적는다(무중단 위반).
#   FAKE_UNHEALTHY    이 글자를 담은 backend 이미지는 healthy 가 안 된다
#   FAKE_BAD_HEALTH   이 글자를 담은 backend 이미지면 마지막 /api/health 가 실패한다
#   FAKE_MIGRATE_FAIL 비어 있지 않으면 migrate 가 실패한다
set -u
echo "docker $*" >> "$FAKE_LOG"
st="$FAKE_STATE"
get() { cat "$st/$1.$2" 2>/dev/null || true; }
put() { printf '%s' "$3" > "$st/$1.$2"; }
has() { [ -n "$2" ] && case "$1" in *"$2"*) return 0 ;; esac; return 1; }
image_of() {
  case "$1" in
    backend|backend2|worker|beat) echo "${DAYPAGE_BACKEND_IMAGE:-local-backend}" ;;
    web) echo "caddy" ;;
    *) echo "$1-fixed" ;;
  esac
}

case "$1" in
  pull|image) exit 0 ;;
  inspect)
    svc="${*: -1}"; svc="${svc#cid-}"
    if [ "$(get "$svc" status)" = starting ]; then
      if has "$(get "$svc" image)" "${FAKE_UNHEALTHY:-}"; then put "$svc" status unhealthy; else put "$svc" status healthy; fi
    fi
    s="$(get "$svc" status)"
    echo "${s:-healthy}"
    exit 0 ;;
  compose) shift ;;
  *) exit 0 ;;
esac

[ "${1:-}" = "--profile" ] && shift 2
case "${1:-}" in
  ps) [ "${2:-}" = "-q" ] && echo "cid-${3:-}"; exit 0 ;;
  logs|build) exit 0 ;;
  run)
    case "$*" in
      *migrate*) echo "MIGRATE" >> "$FAKE_LOG"; [ -n "${FAKE_MIGRATE_FAIL:-}" ] && exit 1 ;;
      *web-dist*) put static image "${DAYPAGE_WEB_DIST_IMAGE:-local-web-dist}" ;;
    esac
    exit 0 ;;
  up)
    shift
    norecreate=0
    svcs=()
    for a in "$@"; do
      case "$a" in
        --no-recreate) norecreate=1 ;;
        -*) ;;
        *) svcs+=("$a") ;;
      esac
    done
    for s in "${svcs[@]}"; do
      want="$(image_of "$s")"
      have="$(get "$s" image)"
      if [ -n "$have" ] && { [ "$norecreate" = 1 ] || [ "$have" = "$want" ]; }; then continue; fi
      if [ "$s" = backend ] || [ "$s" = backend2 ]; then
        other=backend2; [ "$s" = backend2 ] && other=backend
        [ "$(get "$other" status)" = healthy ] || echo "OUTAGE: $s 를 다시 만들 때 $other 가 $(get "$other" status)" >> "$FAKE_LOG"
      fi
      echo "RECREATE $s $want sha=${SANDCORP_IMAGE_SHA:-}" >> "$FAKE_LOG"
      put "$s" image "$want"
      put "$s" status starting
    done
    exit 0 ;;
  exec)
    case "$*" in
      *caddy\ reload*) exit 0 ;;
      *api/health*)
        for b in backend backend2; do
          has "$(get "$b" image)" "${FAKE_BAD_HEALTH:-}" && exit 1
          [ "$(get "$b" status)" = healthy ] || exit 1
        done
        echo '{"status":"ok"}'; exit 0 ;;
    esac
    exit 0 ;;
esac
exit 0

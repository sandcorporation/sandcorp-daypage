{
	# 앞단 프록시(NPMplus)가 넘겨준 X-Forwarded-Proto(https)를 그대로 Django에 전한다.
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS:daypage.sandcorp.co.kr} {
	encode zstd gzip

	# 웹소켓은 경로(노트·날짜)로 백엔드 프로세스를 고른다. 같은 장의 연결이 한 프로세스에 모여
	# 방 안 전달이 메모리에서 끝난다. 한쪽이 죽어 있으면 다른 쪽으로 가고, 나뉜 장은 프로세스끼리 이어 준다.
	@ws path /ws/*
	handle @ws {
		reverse_proxy backend:8000 backend2:8000 {
			lb_policy uri_hash
			fail_duration 10s
			# 배포로 한쪽이 내려가 있으면 잠깐 기다리며 다른 쪽으로 다시 보낸다(무중단 배포)
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	# API·카카오 로그인은 아무 프로세스나
	@backend path /api/* /auth/*
	handle @backend {
		# 봉인 스냅샷(점이 든 바이너리, application/octet-stream)은 Caddy 기본 압축 대상이 아니다.
		# 이 두 경로의 octet-stream만 더 압축한다. 바깥의 encode는 이미 Content-Encoding이 붙은 응답을 건너뛴다.
		@snapshot path_regexp ^/api/(admin/)?notes/[^/]+/pages/[^/]+$
		encode @snapshot zstd gzip {
			match {
				header Content-Type application/octet-stream*
			}
		}
		reverse_proxy backend:8000 backend2:8000 {
			lb_policy round_robin
			fail_duration 10s
			# 배포로 한쪽이 내려가 있으면 잠깐 기다리며 다른 쪽으로 다시 보낸다(무중단 배포)
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	# 운영자 페이지(따로 빌드한 앱). 권한은 앱이 /api/me로, 데이터는 /api/admin이 운영자만 준다.
	@admin path /admin /admin/*
	handle @admin {
		root * /srv
		@adminAssets path /admin/assets/*
		header @adminAssets Cache-Control "public, max-age=31536000, immutable"
		header X-Robots-Tag "noindex"
		redir /admin /admin/ 308
		try_files {path} /admin/index.html
		file_server
	}

	# 나머지는 SPA. 없는 경로는 index.html로(React Router가 처리)
	handle {
		root * /srv
		# 개인 일지(노트·운영자 노트 화면)는 색인하지 않는다. robots.txt가 이 경로의 크롤링도 막지만,
		# 링크로 알려진 URL이 내용 없이 색인되는 것까지는 못 막으므로 헤더를 함께 둔다.
		@private path /note/* /staff/*
		header @private X-Robots-Tag "noindex"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
	}
}

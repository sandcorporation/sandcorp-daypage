// 버리는 확인 PR(jenkins-shared #13) — 병합하지 않는다. 실패 댓글이 달리는지 본다.
@Library('sandcorp@pr-check-failure-comment') _

sandcorpPrCheck(
  name: 'Daypage',
  buildSsh: true,
  check: '''
echo "준비 줄 1"
echo "token=FAKE_NOT_A_SECRET"
echo "ghp_FAKEFAKEFAKE"
echo "-----BEGIN OPENSSH PRIVATE KEY-----"
echo "RkFLRUtFWUJPRFk="
echo "-----END OPENSSH PRIVATE KEY-----"
printf 'tests/test_probe.py::test_probe FAILED\\nE   assert 1 == 2\\n'
exit 3
''',
)

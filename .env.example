# 카카오 로그인 (Kakao Developers > 앱 키 / 보안)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 공유 링크에 쓰는 공개 주소
PUBLIC_ORIGIN=http://localhost:5173

# Django (운영에서 반드시 변경)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# 인프라 (기본값은 docker-compose.yml과 같음)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=daypage
POSTGRES_USER=daypage
POSTGRES_PASSWORD=daypage
REDIS_URL=redis://127.0.0.1:6379/0

# 로컬 수동 확인용 로그인(/auth/dev-login?kakao_id=1). DEBUG일 때만 동작
DJANGO_DEV_LOGIN=false

# ── 운영(docker-compose.prod.yml) ──
# SITE_ADDRESS=daypage.sandcorp.co.kr   # Caddy가 이 도메인으로 HTTPS 인증서를 받는다
# DJANGO_DEBUG=false                    # compose가 강제로 false로 둔다
# DJANGO_SECRET_KEY=<긴 무작위 문자열>
# DJANGO_ALLOWED_HOSTS=daypage.sandcorp.co.kr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://daypage.sandcorp.co.kr
# KAKAO_REDIRECT_URI=https://daypage.sandcorp.co.kr/auth/kakao/callback
# PUBLIC_ORIGIN=https://daypage.sandcorp.co.kr
# POSTGRES_PASSWORD=<강한 비밀번호>

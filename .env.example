# 카카오 로그인 (Kakao Developers > 앱 키 / 보안)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 공유 링크에 쓰는 공개 주소
PUBLIC_ORIGIN=http://localhost:5173

# Django (운영에서 반드시 변경)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# 인프라 (기본값은 docker-compose.yml과 같음)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=daypage
POSTGRES_USER=daypage
POSTGRES_PASSWORD=daypage
REDIS_URL=redis://127.0.0.1:6379/0

# 로컬 수동 확인용 로그인(/auth/dev-login?kakao_id=1). DEBUG일 때만 동작
DJANGO_DEV_LOGIN=false

# ── 운영(docker-compose.prod.yml) ──
# SITE_ADDRESS=daypage.sandcorp.co.kr   # Caddy가 이 도메인으로 HTTPS 인증서를 받는다
# DJANGO_DEBUG=false                    # compose가 강제로 false로 둔다
# DJANGO_SECRET_KEY=<긴 무작위 문자열>
# DJANGO_ALLOWED_HOSTS=daypage.sandcorp.co.kr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://daypage.sandcorp.co.kr
# KAKAO_REDIRECT_URI=https://daypage.sandcorp.co.kr/auth/kakao/callback
# PUBLIC_ORIGIN=https://daypage.sandcorp.co.kr
# POSTGRES_PASSWORD=<강한 비밀번호>


# ── 수용 인원·대기열 ──
# 수용 인원 = 백엔드마다 CPU 제한(cgroup cpu.max) × 코어당 인원의 합. CPU 제한이 없으면(로컬) 제한이 꺼진다.
# MAX_ONLINE_PER_CORE=180
# AWAY_AFTER=600              # 대기자가 있을 때 이만큼(초) 입력이 없는 사람부터 내보낸다
# QUEUE_POLL_EVERY=2          # 대기자에게 순번을 다시 알리는 간격(초)
# CGROUP_CPU_MAX_PATH=/sys/fs/cgroup/cpu.max

# 메트릭 스니펫(#51): 프런트 빌드 때 index.html head에 <script defer src=... data-site="daypage">를 넣는다. 비우면 안 넣는다.
# VITE_METRICS_SNIPPET_URL=https://metrics.sandcorp.co.kr/m.js

# ── 사진(건의 #9) ──
# Oracle Object Storage의 S3 호환 API. 넷(엔드포인트·버킷·키 둘)이 다 있어야 사진 붙이기가 켜진다(비면 버튼이 안 보인다).
# 버킷은 비공개(Private)로 만든다. 사진은 백엔드가 참여자인지 확인하고 대신 받아 준다.
# 운영 값: 버킷 daypage-prod-photos, 사용자·그룹·정책 daypage-prod-storage(그 버킷의 객체만). 키는 sub2 ~/.oci/daypage-prod-storage.env.
# 새로 만들면 그 사용자의 Customer secret key로(퍼지는 데 5분쯤 걸린다).
# PHOTO_S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
# PHOTO_S3_REGION=ap-chuncheon-1
# PHOTO_S3_BUCKET=daypage-prod-photos
# PHOTO_S3_ACCESS_KEY=
# PHOTO_S3_SECRET_KEY=
